{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec serve out -l 4322 --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/county/kent/",
        "http://localhost:4322/county/kent/deer-hunting/",
        "http://localhost:4322/county/roscommon/walleye-fishing/",
        "http://localhost:4322/hunting/deer/",
        "http://localhost:4322/fishing/walleye/",
        "http://localhost:4322/lake/roscommon/higgins-lake/",
        "http://localhost:4322/public-land/allegan-state-game-area/",
        "http://localhost:4322/seasons/deer/",
        "http://localhost:4322/data/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["canonical", "is-crawlable", "uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1200
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
