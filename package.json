{
  "name": "michigan-outdoors-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx scripts/generate-static-assets.ts && next dev",
    "build": "tsx scripts/generate-static-assets.ts && tsx scripts/generate-og-images.tsx && next build && tsx scripts/post-build.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 && tsx scripts/check-no-comments.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:seo": "tsx scripts/seo-check.ts",
    "check:links": "tsx scripts/link-check.ts",
    "og": "tsx scripts/generate-og-images.tsx",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:snapshot": "tsx scripts/export-snapshot.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:seo && pnpm check:links"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "schema-dts": "2.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "5.0.1",
    "cheerio": "1.2.0",
    "domhandler": "^6.0.1",
    "dotenv": "18.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "satori": "^0.33.5",
    "serve": "^14.2.6",
    "tailwindcss": "4.3.3",
    "tinyglobby": "0.2.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
